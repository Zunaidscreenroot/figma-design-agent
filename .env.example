# Gemini (direct Google AI API)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-3-27b-it:free,openrouter/free
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_FALLBACK_MODELS=openrouter/free,dots-studio/dots3-note-preview:free

# Agent tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=6000
LLM_RETRIES=1
LLM_RETRY_BASE_MS=1200
MAX_ACTIONS_PER_PLAN=80
MAX_REPAIR_LOOPS=2
