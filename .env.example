# OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_FALLBACK_MODELS=openrouter/free,dots-studio/dots3-note-preview:free

# Supabase UX memory (server-only; never expose the service role key to the plugin/browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UX_MEMORY_PROJECT_KEY=default

# Attach up to two previously accepted example screenshots to model prompts.
# Enable only when LLM_MODEL and fallbacks support image input; this adds image-token cost.
UX_MEMORY_VISUAL_REFERENCES=false

# Agent tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=6000
LLM_RETRIES=1
LLM_RETRY_BASE_MS=1200
MAX_ACTIONS_PER_PLAN=80
MAX_REPAIR_LOOPS=2
