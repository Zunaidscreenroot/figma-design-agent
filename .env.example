# OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_FALLBACK_MODELS=openrouter/free,dots-studio/dots3-note-preview:free
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=6000
LLM_RETRIES=1
LLM_RETRY_BASE_MS=1200

# Agent limits
MAX_ACTIONS_PER_PLAN=80
MAX_REPAIR_LOOPS=2

# Optional Supabase long-term memory. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for deployed/production API servers; plugin sends this as a Bearer token.
# Do not commit a real token.
AGENT_API_TOKEN=
AGENT_ALLOWED_ORIGIN=*
