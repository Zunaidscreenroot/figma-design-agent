# Google Gemini API (server-side only; configure GEMINI_API_KEY in Vercel)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash

# Agent tuning
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=6000
LLM_RETRIES=1
LLM_RETRY_BASE_MS=1200
MAX_ACTIONS_PER_PLAN=80
MAX_REPAIR_LOOPS=2
